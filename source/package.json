{
  "name": "na-sebe-pages-source",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run check && npm run test:game && npm run test:review && npm run test:stories && npm run test:room && npm run test:storage && npm run test:build && npm run test:progression && npm run test:campaign",
    "test:game": "node scripts/check-game.mjs",
    "test:review": "node scripts/check-review.mjs",
    "test:stories": "node scripts/check-situations.mjs && node scripts/check-random-stories.mjs",
    "test:room": "node scripts/check-room.mjs",
    "test:storage": "node scripts/check-storage.mjs",
    "test:build": "node scripts/check-build.mjs",
    "benchmark": "node scripts/benchmark-model.mjs",
    "test:progression": "node scripts/check-progression.mjs",
    "test:campaign": "node scripts/check-campaign.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "0.28.2",
    "prettier": "3.6.2",
    "purgecss": "8.0.0",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
